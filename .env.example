# ============== nexus — variables de entorno ==============
# Copia este archivo como ".env" y rellena lo que tengas.
# ESTE archivo SÍ se sube al repositorio: aquí solo van ejemplos, nunca valores
# reales. (El 25/07/2026 llevaba la contraseña de verdad del Postgres local.)

# ---- TTS ElevenLabs (opcional; sin key usa voz local) ----
ELEVENLABS_API_KEY=

# ---- LLM cloud (opcional; API compatible OpenAI) ----
# Ejemplos de base_url: https://api.openai.com/v1 · https://openrouter.ai/api/v1
#                       https://api.groq.com/openai/v1
CLOUD_LLM_API_KEY=

# ---- Memoria Postgres (contenedor nexus, puerto 5433) ----
# Pon TU usuario y TU contraseña en el .env, no aquí.
NEXUS_DB_URL=postgresql://USUARIO:CONTRASENA@localhost:5433/nexus_core

# ---- Telegram (futuro control remoto real) ----
TELEGRAM_BOT_TOKEN=
