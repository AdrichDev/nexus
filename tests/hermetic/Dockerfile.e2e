FROM nexus-hermetic-test
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN pip install --no-cache-dir playwright && python -m playwright install --with-deps chromium \
    && chmod -R a+rX /ms-playwright
# Run as an unprivileged user (Trivy DS-0002). /work is a tmpfs mounted at run time.
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin e2e
USER 10001
